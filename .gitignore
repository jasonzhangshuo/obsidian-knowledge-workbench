# Reviewed code/documentation allowlist: this directory also contains private data.
/*
!/.gitignore
!/.env.example
!/AGENTS.md
!/README.md
!/tools/
!/tools/**
!/tests/
!/tests/**
!/prompts/
!/prompts/**
!/skills/
!/skills/**
!/config/
!/config/**
!/docs/
/docs/*
!/docs/engineering/
!/docs/engineering/**
!/docs/development/
!/docs/development/**
!/archive/
!/archive/**

# Runtime artifacts remain untracked even beneath an allowed code directory.
**/__pycache__/
**/*.py[cod]
**/.DS_Store
**/.env
**/.env.*
!/.env.example
**/auth.json
**/credentials.json
**/*.pdf
**/*.epub
**/*.zip
**/*.jsonl
**/*.log
**/*.sqlite*
**/node_modules/
**/.venv/
